{
  "version":"2.0",
  "metadata":{
    "apiVersion":"2018-05-10",
    "auth":["aws.auth#sigv4"],
    "endpointPrefix":"transformagentsstreamingservice",
    "protocol":"rest-json",
    "protocols":["rest-json"],
    "serviceFullName":"TransformAgentsStreamingService",
    "serviceId":"TransformAgentsStreaming",
    "signatureVersion":"v4",
    "signingName":"transform-agents",
    "uid":"transformagentsstreaming-2018-05-10"
  },
  "operations":{
    "ConverseStream":{
      "name":"ConverseStream",
      "http":{
        "method":"POST",
        "requestUri":"/agents/{agentInstanceId}/message/stream",
        "responseCode":200
      },
      "input":{"shape":"ConverseStreamRequest"},
      "output":{"shape":"ConverseStreamResponse"},
      "errors":[
        {"shape":"ThrottlingException"},
        {"shape":"ConflictException"},
        {"shape":"AccessDeniedException"},
        {"shape":"ResourceNotFoundException"},
        {"shape":"DependencyInternalServerException"},
        {"shape":"ServiceQuotaExceededException"},
        {"shape":"InternalServerException"},
        {"shape":"ValidationException"},
        {"shape":"TerminalResourceException"}
      ],
      "documentation":"<p>Streaming counterpart of SendMessage: the caller names the callee by agentInstanceId and receives the callee's response as a live SSE stream of A2A frames. Modeled similarly to the A2A protocol method message/stream (https://a2a-protocol.org/latest/specification/#72-messagestream).</p>"
    }
  },
  "shapes":{
    "A2ASseStream":{
      "type":"blob",
      "documentation":"<p>Unbounded stream of raw SSE bytes (text/event-stream) carrying <code>data: {A2A frame}\\n\\n</code> frames.</p>",
      "streaming":true
    },
    "AccessDeniedException":{
      "type":"structure",
      "required":["message"],
      "members":{
        "message":{"shape":"String"},
        "reasonCode":{"shape":"AccessDeniedExceptionReason"}
      },
      "error":{
        "httpStatusCode":403,
        "senderFault":true
      },
      "exception":true
    },
    "AccessDeniedExceptionReason":{
      "type":"string",
      "enum":[
        "EXPIRED_TOKEN",
        "TOKEN_CLAIM_MISMATCH",
        "INVALID_TOKEN"
      ]
    },
    "AuthorizationToken":{
      "type":"string",
      "max":4096,
      "min":1,
      "pattern":"[.+=A-Za-z0-9_-]+",
      "sensitive":true
    },
    "ConflictException":{
      "type":"structure",
      "required":["message"],
      "members":{
        "message":{"shape":"String"},
        "resourceId":{"shape":"String"},
        "resourceType":{"shape":"String"}
      },
      "error":{
        "httpStatusCode":409,
        "senderFault":true
      },
      "exception":true
    },
    "ConverseStreamRequest":{
      "type":"structure",
      "required":[
        "requestContext",
        "agentInstanceId"
      ],
      "members":{
        "requestContext":{"shape":"RequestContext"},
        "agentInstanceId":{
          "shape":"Uuid",
          "location":"uri",
          "locationName":"agentInstanceId"
        },
        "params":{
          "shape":"Document",
          "documentation":"<p>Will follow https://a2a-protocol.org/latest/specification/#711-messagesendparams-object</p>"
        }
      }
    },
    "ConverseStreamResponse":{
      "type":"structure",
      "required":["stream"],
      "members":{
        "contentType":{
          "shape":"String",
          "location":"header",
          "locationName":"Content-Type"
        },
        "stream":{
          "shape":"A2ASseStream",
          "documentation":"<p>SSE byte stream: each <code>data:</code> line is one bare A2A frame object (a <code>task</code> opener then <code>status-update</code> frames), terminating on a final status-update.</p>"
        }
      },
      "payload":"stream"
    },
    "DependencyInternalServerException":{
      "type":"structure",
      "required":["message"],
      "members":{
        "message":{"shape":"String"}
      },
      "documentation":"<p>This exception denotes that an error occurred in the dependency of a service while processing a request.</p>",
      "error":{"httpStatusCode":500},
      "exception":true,
      "fault":true
    },
    "Document":{
      "type":"structure",
      "members":{},
      "document":true
    },
    "Integer":{
      "type":"integer",
      "box":true
    },
    "InternalServerException":{
      "type":"structure",
      "required":["message"],
      "members":{
        "message":{"shape":"String"},
        "retryAfterSeconds":{
          "shape":"Integer",
          "location":"header",
          "locationName":"Retry-After"
        }
      },
      "error":{"httpStatusCode":500},
      "exception":true,
      "fault":true,
      "retryable":{"throttling":false}
    },
    "JobMetadata":{
      "type":"structure",
      "required":[
        "jobId",
        "workspaceId"
      ],
      "members":{
        "jobId":{"shape":"Uuid"},
        "workspaceId":{"shape":"Uuid"}
      },
      "documentation":"<p>Represents the Transformation JobId and the Workspace Id</p>"
    },
    "RequestContext":{
      "type":"structure",
      "required":[
        "jobMetadata",
        "agentInstanceId",
        "authorizationToken"
      ],
      "members":{
        "jobMetadata":{"shape":"JobMetadata"},
        "agentInstanceId":{
          "shape":"Uuid",
          "documentation":"<p>InvocationId of the agent making the API request.</p>"
        },
        "authorizationToken":{
          "shape":"AuthorizationToken",
          "documentation":"<p>Token passed by the ATX Foundation to the agents</p>"
        }
      },
      "documentation":"<p>Common structure encapsulating Job Details and Caller Agent's identification expected in all requests</p>"
    },
    "ResourceNotFoundException":{
      "type":"structure",
      "required":["message"],
      "members":{
        "message":{"shape":"String"},
        "resourceId":{"shape":"String"},
        "resourceType":{"shape":"String"}
      },
      "error":{
        "httpStatusCode":404,
        "senderFault":true
      },
      "exception":true
    },
    "ServiceQuotaExceededException":{
      "type":"structure",
      "required":["message"],
      "members":{
        "message":{"shape":"String"},
        "resourceId":{"shape":"String"},
        "resourceType":{"shape":"String"},
        "serviceCode":{"shape":"String"},
        "quotaCode":{"shape":"String"}
      },
      "error":{
        "httpStatusCode":402,
        "senderFault":true
      },
      "exception":true
    },
    "String":{"type":"string"},
    "TerminalResourceException":{
      "type":"structure",
      "required":["message"],
      "members":{
        "message":{"shape":"String"}
      },
      "error":{
        "httpStatusCode":410,
        "senderFault":true
      },
      "exception":true
    },
    "ThrottlingException":{
      "type":"structure",
      "required":["message"],
      "members":{
        "message":{"shape":"String"},
        "serviceCode":{"shape":"String"},
        "quotaCode":{"shape":"String"},
        "retryAfterSeconds":{
          "shape":"Integer",
          "location":"header",
          "locationName":"Retry-After"
        }
      },
      "error":{
        "httpStatusCode":429,
        "senderFault":true
      },
      "exception":true,
      "retryable":{"throttling":true}
    },
    "Uuid":{
      "type":"string",
      "pattern":"[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}"
    },
    "ValidationException":{
      "type":"structure",
      "required":["message"],
      "members":{
        "message":{"shape":"String"},
        "reason":{"shape":"ValidationExceptionReason"},
        "fieldList":{"shape":"ValidationExceptionFieldList"}
      },
      "error":{
        "httpStatusCode":400,
        "senderFault":true
      },
      "exception":true
    },
    "ValidationExceptionField":{
      "type":"structure",
      "required":[
        "name",
        "message"
      ],
      "members":{
        "name":{"shape":"String"},
        "message":{"shape":"String"}
      }
    },
    "ValidationExceptionFieldList":{
      "type":"list",
      "member":{"shape":"ValidationExceptionField"}
    },
    "ValidationExceptionReason":{
      "type":"string",
      "enum":[
        "FIELD_VALIDATION_FAILED",
        "OTHER"
      ]
    }
  },
  "clientContextParams":{
    "Stage":{
      "documentation":"The service stage this client will connect to",
      "type":"string"
    },
    "UseExternalEndpoint":{
      "documentation":"Use external endpoint pattern for transform-agents service",
      "type":"boolean"
    }
  }
}
